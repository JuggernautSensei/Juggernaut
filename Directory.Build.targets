<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Juggernaut 안에서 빌드할 때 서브모듈 라이브러리(JugX / JugGfx / JugNet)도 루트 vcpkg manifest 를 사용한다.
    서브모듈마다 vcpkg_installed 가 따로 있으면 같은 헤더가 여러 벌 생겨 IntelliSense 가 심볼을 모호하다고 판단한다.
    루트 vcpkg.json 은 세 라이브러리 의존성의 상위 집합. 서브모듈 단독 빌드 시에는 이 파일이 없으므로 각자 manifest 를 그대로 쓴다.
    Test / Bench 는 test / bench feature(gtest, benchmark 등)가 필요하므로 제외.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'JugX' Or '$(MSBuildProjectName)' == 'JugGfx' Or '$(MSBuildProjectName)' == 'JugNet'">
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
  </PropertyGroup>
</Project>
